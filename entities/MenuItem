{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the menu item"
    },
    "category": {
      "type": "string",
      "enum": [
        "coffee",
        "espresso",
        "tea",
        "juice",
        "smoothie",
        "pastry",
        "sandwich",
        "bakery",
        "vegan"
      ],
      "description": "Category of the item"
    },
    "description": {
      "type": "string",
      "description": "Short description"
    },
    "tagline": {
      "type": "string",
      "description": "Short tagline like 'Chocolate & creamy'"
    },
    "price_small": {
      "type": "number",
      "description": "Price for small size"
    },
    "price_medium": {
      "type": "number",
      "description": "Price for medium size"
    },
    "price_large": {
      "type": "number",
      "description": "Price for large size"
    },
    "image_url": {
      "type": "string",
      "description": "Product image URL"
    },
    "rating": {
      "type": "number",
      "description": "Rating out of 5"
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_daily_feature": {
      "type": "boolean",
      "default": false,
      "description": "Show this item in today's daily features section"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "category",
    "price_medium"
  ]
}